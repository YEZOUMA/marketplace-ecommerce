# ------------------------------------------------------------------
# Copiez ce fichier en `.env` à la racine du projet avant de lancer
# `docker compose up`. Ne commitez jamais le fichier `.env` réel.
# ------------------------------------------------------------------

# --- Général ---
NODE_ENV=production
CORS_ORIGIN=http://localhost

# --- PostgreSQL ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=marketplace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://marketplace:change-me-postgres-password@db:5432/marketplace?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Stockage des images ---
# STORAGE_MODE=local  -> volume Docker local (par défaut, simple)
# STORAGE_MODE=minio  -> bucket S3-compatible MinIO
STORAGE_MODE=local
STORAGE_LOCAL_DIR=/app/uploads

# MINIO_ROOT_USER/PASSWORD are used both to start the MinIO server and (via
# docker-compose.yml's variable substitution) as the backend's access/secret
# key — set them once here, no need to repeat them.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=product-images
MINIO_PUBLIC_URL=http://localhost/product-images
MINIO_CONSOLE_PORT=9001

# --- Frais de publication vendeur ---
PUBLICATION_FEE_AMOUNT=500
PUBLICATION_FEE_CURRENCY=XOF

# --- Paiement mobile money ---
# En mode mock (par défaut), aucune clé réelle n'est nécessaire : le flux
# paiement -> webhook est simulé pour permettre de tester l'application de
# bout en bout. Passez à "false" et renseignez les clés de chaque
# prestataire une fois vos comptes marchands obtenus.
PAYMENTS_MOCK_MODE=true
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-shared-secret

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_BASE_URL=

MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_BASE_URL=

WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_BASE_URL=

SANK_MONEY_API_KEY=
SANK_MONEY_API_SECRET=
SANK_MONEY_BASE_URL=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Seed initial ---
RUN_SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@marketplace.local
SEED_ADMIN_PASSWORD=ChangeMoi123!

# --- Frontend (variable injectée au build) ---
VITE_API_BASE_URL=/api

# --- Ports exposés sur l'hôte ---
HTTP_PORT=80
BACKEND_PORT=4000
FRONTEND_PORT=5173
