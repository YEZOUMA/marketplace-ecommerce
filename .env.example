# ==================================================================
#  Copiez ce fichier en `.env` à la racine du projet avant de lancer
#  `docker compose up`. Ne commitez JAMAIS le fichier `.env` réel
#  (il contient de vrais secrets) — il est déjà exclu par .gitignore.
#
#  Ce fichier est découpé en deux parties :
#   1. Valeurs à changer OBLIGATOIREMENT avant un déploiement réel
#   2. Valeurs que vous pouvez laisser telles quelles pour commencer
#
#  Le README (section "Déploiement en production") explique chaque
#  valeur en détail, avec les commandes exactes pour générer des
#  secrets sûrs.
# ==================================================================


# ############################################################
# # 1. À CHANGER OBLIGATOIREMENT avant un déploiement réel     #
# ############################################################

# Adresse de votre site.
#   - En local (par défaut) : laissez "http://localhost", aucun certificat
#     n'est nécessaire, Caddy sert le site en HTTP simple.
#   - En production : remplacez par votre nom de domaine SANS "http://" ni
#     "https://", par ex. SITE_ADDRESS=boutique.exemple.com
#     Caddy (le reverse proxy) détectera qu'il s'agit d'un vrai domaine et
#     obtiendra puis renouvellera automatiquement un certificat HTTPS
#     Let's Encrypt — sans aucune action de votre part, à condition que :
#       a) le DNS du domaine pointe déjà vers l'IP de ce serveur, et
#       b) les ports 80 et 443 soient ouverts/accessibles depuis Internet.
SITE_ADDRESS=http://localhost

# CORS_ORIGIN doit correspondre à l'adresse publique de votre site (avec le
# schéma http:// ou https://). Elle n'est utilisée que si un navigateur
# appelle directement l'API depuis une origine différente de Caddy — ce qui
# n'arrive pas dans l'usage normal (le navigateur ne parle qu'à Caddy, qui
# route en interne), donc cette valeur peut rester quasi n'importe quoi de
# cohérent avec SITE_ADDRESS.
CORS_ORIGIN=http://localhost

# Mot de passe PostgreSQL. Choisissez une valeur unique et forte — elle sert
# aussi automatiquement à construire l'URL de connexion du backend, vous
# n'avez besoin de la changer qu'à CET endroit.
# Générer un mot de passe fort : openssl rand -hex 16
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=marketplace

# Secrets JWT (signature des jetons de connexion). Deux valeurs DIFFÉRENTES,
# longues et aléatoires. Générer chacune avec : openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Secret partagé pour vérifier la signature des webhooks de paiement mobile
# money. Générer avec : openssl rand -hex 32
PAYMENTS_WEBHOOK_SECRET=change-me-webhook-shared-secret

# Identifiants du compte administrateur créé automatiquement au premier
# démarrage. Changez au moins le mot de passe — vous pourrez le modifier
# depuis l'interface admin après votre première connexion.
SEED_ADMIN_EMAIL=admin@marketplace.local
SEED_ADMIN_PASSWORD=ChangeMoi123!

# Note de sécurité : au démarrage, l'application refuse de démarrer en
# production (NODE_ENV=production) si l'une des valeurs ci-dessus contient
# encore un mot d'exemple ("change-me", "changeme"...). C'est volontaire :
# mieux vaut un échec clair au démarrage qu'une faille de sécurité silencieuse.


# ############################################################
# # 2. Peut rester tel quel pour commencer                    #
# ############################################################

NODE_ENV=production

# --- Stockage des images produits ---
# STORAGE_MODE=local (par défaut) : les images sont stockées dans un volume
#   Docker sur ce serveur. Simple, suffisant pour la grande majorité des cas.
#   Vous n'avez RIEN d'autre à configurer dans cette section si vous gardez
#   cette valeur — ignorez le reste du bloc MinIO ci-dessous.
# STORAGE_MODE=minio : stockage façon S3 (utile si vous prévoyez beaucoup de
#   trafic ou voulez répartir les images sur un autre serveur). Nécessite de
#   démarrer le service optionnel : docker compose --profile minio up -d
STORAGE_MODE=local
STORAGE_LOCAL_DIR=/app/uploads

# Uniquement utilisé si STORAGE_MODE=minio.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ENDPOINT=storage
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=product-images
# Remplacez "localhost" par votre domaine (même valeur que SITE_ADDRESS) si
# vous activez MinIO en production.
MINIO_PUBLIC_URL=http://localhost/product-images

# --- Frais de publication vendeur ---
PUBLICATION_FEE_AMOUNT=500
PUBLICATION_FEE_CURRENCY=XOF

# --- Paiement mobile money ---
# En mode mock (par défaut), aucune clé réelle n'est nécessaire : le flux
# paiement -> webhook est simulé pour permettre de tester l'application de
# bout en bout, y compris en production, avant d'avoir vos comptes marchands.
# Passez à "false" et renseignez les clés d'au moins un prestataire une fois
# vos comptes marchands obtenus (l'application refuse de démarrer avec
# PAYMENTS_MOCK_MODE=false si aucune clé n'est renseignée).
PAYMENTS_MOCK_MODE=true

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_BASE_URL=

MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_BASE_URL=

WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_BASE_URL=

SANK_MONEY_API_KEY=
SANK_MONEY_API_SECRET=
SANK_MONEY_BASE_URL=

# --- Divers ---
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RUN_SEED_ON_START=true

# --- Frontend (valeur injectée au moment du build de l'image) ---
# "/api" fonctionne quel que soit votre domaine (chemin relatif, Caddy route
# en interne) — vous n'avez normalement jamais besoin de changer ceci.
VITE_API_BASE_URL=/api

# --- Ports publiés sur l'hôte ---
# Seul Caddy est exposé publiquement (80 = HTTP, redirige vers 443 dès qu'un
# vrai domaine est configuré ; 443 = HTTPS). La base de données, MinIO et le
# backend ne sont volontairement PAS exposés sur l'hôte : ils ne sont
# joignables qu'entre conteneurs, ce qui réduit la surface d'attaque.
HTTP_PORT=80
HTTPS_PORT=443
