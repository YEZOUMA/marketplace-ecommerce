// Prisma schema for the multi-vendor marketplace
// Datasource: PostgreSQL
// Field names are camelCase in the Prisma Client API but mapped (@map) to
// snake_case columns, matching prisma/init.sql and standard SQL convention.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  VENDEUR
  ADMIN
}

enum ProductStatus {
  BROUILLON
  EN_ATTENTE_PAIEMENT
  PUBLIE
  SUSPENDU
}

enum PaymentProvider {
  ORANGE_MONEY
  MOOV_MONEY
  WAVE
  SANK_MONEY
}

enum PaymentStatus {
  EN_ATTENTE
  REUSSI
  ECHOUE
}

enum OrderStatus {
  EN_ATTENTE
  CONFIRMEE
  EXPEDIEE
  LIVREE
  ANNULEE
}

model User {
  id           String   @id @default(uuid())
  nom          String
  email        String   @unique
  telephone    String?
  motDePasse   String   @map("mot_de_passe")
  role         UserRole @default(CLIENT)
  dateCreation DateTime @default(now()) @map("date_creation")
  updatedAt    DateTime @updatedAt @map("updated_at")

  produits          Product[]                    @relation("VendeurProducts")
  commandes         Order[]                      @relation("ClientOrders")
  paiementsProduits ProductPublicationPayment[]   @relation("VendeurPayments")
  refreshTokens     RefreshToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id       String    @id @default(uuid())
  nom      String    @unique
  produits Product[]

  @@map("categories")
}

model Product {
  id           String        @id @default(uuid())
  vendeurId    String        @map("vendeur_id")
  vendeur      User          @relation("VendeurProducts", fields: [vendeurId], references: [id], onDelete: Cascade)
  nom          String
  description  String
  prix         Decimal       @db.Decimal(12, 2)
  stock        Int           @default(0)
  categorieId  String?       @map("categorie_id")
  categorie    Category?     @relation(fields: [categorieId], references: [id])
  statut       ProductStatus @default(BROUILLON)
  dateCreation DateTime      @default(now()) @map("date_creation")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  images     ProductImage[]
  orderItems OrderItem[]
  paiements  ProductPublicationPayment[]

  @@index([vendeurId])
  @@index([categorieId])
  @@index([statut])
  @@index([nom])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  ordre     Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model ProductPublicationPayment {
  id                   String          @id @default(uuid())
  productId            String          @map("product_id")
  product              Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendeurId            String          @map("vendeur_id")
  vendeur              User            @relation("VendeurPayments", fields: [vendeurId], references: [id], onDelete: Cascade)
  montant              Decimal         @db.Decimal(12, 2)
  devise               String          @default("XOF")
  prestataire          PaymentProvider
  referenceTransaction String          @unique @map("reference_transaction")
  statut               PaymentStatus   @default(EN_ATTENTE)
  dateCreation         DateTime        @default(now()) @map("date_creation")
  dateConfirmation     DateTime?       @map("date_confirmation")
  metadata             Json?

  @@index([productId])
  @@index([vendeurId])
  @@index([statut])
  @@index([referenceTransaction])
  @@map("product_publication_payments")
}

model Order {
  id               String      @id @default(uuid())
  clientId         String      @map("client_id")
  client           User        @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  statut           OrderStatus @default(EN_ATTENTE)
  total            Decimal     @db.Decimal(12, 2)
  adresseLivraison String      @map("adresse_livraison")
  notes            String?
  dateCreation     DateTime    @default(now()) @map("date_creation")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([clientId])
  @@index([statut])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String  @map("product_id")
  product      Product @relation(fields: [productId], references: [id])
  quantite     Int
  prixUnitaire Decimal @map("prix_unitaire") @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
