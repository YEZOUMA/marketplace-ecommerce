# Local (non-Docker) development. Copy to backend/.env and adjust as needed.
# For docker compose, use the root .env.example instead.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_MODE=local
STORAGE_LOCAL_DIR=./uploads

PUBLICATION_FEE_AMOUNT=500
PUBLICATION_FEE_CURRENCY=XOF

PAYMENTS_MOCK_MODE=true
PAYMENTS_WEBHOOK_SECRET=dev-webhook-secret

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=
ORANGE_MONEY_BASE_URL=

MOOV_MONEY_API_KEY=
MOOV_MONEY_API_SECRET=
MOOV_MONEY_BASE_URL=

WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_BASE_URL=

SANK_MONEY_API_KEY=
SANK_MONEY_API_SECRET=
SANK_MONEY_BASE_URL=

RUN_SEED_ON_START=false
SEED_ADMIN_EMAIL=admin@marketplace.local
SEED_ADMIN_PASSWORD=ChangeMoi123!
